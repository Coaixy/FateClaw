{
  "manifestVersion": 2,
  "name": "Composite Fallback Demo",
  "description": "用于测试 fallback-only composite tool 的 demo skill",
  "trigger": "测试 composite fallback",
  "requiresLoad": true,
  "entry": {
    "type": "tool",
    "tool": "demo_composite_echo",
    "fallbackScript": "ask.js"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "description": "测试回显内容"
      }
    }
  }
}
