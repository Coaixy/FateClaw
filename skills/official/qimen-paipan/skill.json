{
  "manifestVersion": 2,
  "name": "奇门遁甲排盘",
  "description": "奇门遁甲排盘（时家拆补法）：返回排局、值符值使、天地盘、八门九星八神、马星、长生运等，基于 kinqimen 本地计算",
  "trigger": "用户询问奇门遁甲、时家奇门、值符值使、八门九星、天地盘相关问题，或需要按指定时间起奇门局",
  "requiresLoad": true,
  "entry": {
    "type": "script",
    "file": "paipan.js"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "solarDate": {
        "type": "string",
        "description": "阳历日期 YYYY-MM-DD。不传则用当前时间"
      },
      "hour": {
        "type": "integer",
        "description": "小时 0-23（24 小时制）。不传则用当前时间",
        "minimum": 0,
        "maximum": 23
      },
      "minute": {
        "type": "integer",
        "description": "分钟 0-59；与 solarDate/hour 一起传时默认 0",
        "minimum": 0,
        "maximum": 59,
        "default": 0
      }
    },
    "allOrNoneOf": [["solarDate", "hour"]],
    "examples": [
      {
        "name": "默认当前时间起盘",
        "value": {}
      },
      {
        "name": "指定时间起盘",
        "value": {
          "solarDate": "2026-04-17",
          "hour": 14,
          "minute": 30
        }
      }
    ]
  }
}
