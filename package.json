{
  "name": "fateclaw",
  "version": "1.2.21",
  "description": "FateClaw（命枢）是具备排盘和用户知识库检索能力的开源玄学 Agent。",
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:server",
    "build:api": "npm --workspace @fateclaw/api run build",
    "build:agent": "npm --workspace fateclaw-agent-runner run build",
    "build:web": "npm --workspace fateclaw-web run build",
    "build:server": "npm run build:api && npm run build:agent",
    "build:all": "npm run build:server && npm run build:web",
    "start": "npm --workspace @fateclaw/api run start",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @fateclaw/api dev\" \"pnpm --filter fateclaw-web dev\"",
    "dev:api": "pnpm --filter @fateclaw/api dev",
    "dev:api-only": "pnpm --filter @fateclaw/api dev:api-only",
    "dev:light": "concurrently -n api,web -c blue,green \"pnpm --filter @fateclaw/api dev:api-only\" \"pnpm --filter fateclaw-web dev\"",
    "dev:web": "pnpm --filter fateclaw-web dev",
    "typecheck": "pnpm --filter @fateclaw/api typecheck && pnpm --filter fateclaw-agent-runner exec tsc --noEmit && pnpm --filter fateclaw-web exec tsc --noEmit",
    "format": "pnpm --filter @fateclaw/api format",
    "format:fix": "pnpm --filter @fateclaw/api format:fix",
    "format:check": "pnpm --filter @fateclaw/api format:check",
    "lint": "pnpm --filter @fateclaw/api lint",
    "lint:fix": "pnpm --filter @fateclaw/api lint:fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "login": "pnpm --filter @fateclaw/api login",
    "accounts": "pnpm --filter @fateclaw/api accounts",
    "account:remove": "pnpm --filter @fateclaw/api account:remove",
    "clean": "bash scripts/clean.sh",
    "clean:all": "bash scripts/clean.sh --all",
    "clean:dist": "bash scripts/clean.sh --dist",
    "pack": "bash scripts/pack.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.15.0",
    "javascript-obfuscator": "^5.4.1",
    "terser": "^5.46.1",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
