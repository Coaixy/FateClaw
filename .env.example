# FateClaw（命枢）环境变量配置
# 复制此文件为 .env 后按需填写。生产环境必须使用强随机密钥。
# 下列变量均为当前源码支持的配置；带默认值的项可保持注释。

# --- 基础设施 --------------------------------------------------------------
# 本地默认值和 docker-compose.yml 保持一致。
# 服务端和 agent 使用的时区；当前需作为进程环境变量传入，单独写在 .env 不会被 API 读取。
# TZ=Asia/Shanghai
# PostgreSQL 连接地址；API 启动时会自动创建和补齐表结构。
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fateclaw
# Redis 连接地址；用于限流、验证码、IPC 和消息缓存。
# REDIS_URL=redis://127.0.0.1:6379
# JWT 签名密钥；必须使用强随机值，生产环境不要复用示例值。
# JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
# 全权限管理后台认证密钥；不配置时超级管理员入口不可用。
# MANAGER_KEY=replace-with-strong-random-admin-key-at-least-32-chars
# 用户管理员认证密钥；仅允许管理用户和消息模块。
# USER_MANAGER_KEY=replace-with-strong-random-user-manager-key-at-least-32-chars
# 生产环境 CORS 白名单，多个来源用英文逗号分隔；当前需作为进程环境变量传入。
# ALLOWED_ORIGINS=https://your-domain.example

# --- API 运行时（可选）------------------------------------------------------
# API 监听端口。
# API_PORT=3000
# API 监听地址；容器或远程访问通常用 0.0.0.0。
# API_HOST=0.0.0.0
# 本地 agent-runner 入口选择：auto 自动判断，src 使用源码入口，dist 使用构建产物。
# LOCAL_AGENT_ENTRY_MODE=auto
# 用户 Text Skill Bundle 根目录；默认使用仓库下 .fateclaw/text-skills。
# FATECLAW_TEXT_SKILLS_DIR=.fateclaw/text-skills
# agent-runtime Pi session 文件目录；不填时使用运行时默认目录。
# FATECLAW_PI_SESSION_DIR=
# 微信 Bot 请求等待 agent 返回的超时时间，单位毫秒。
# AGENT_REQUEST_TIMEOUT=1800000
# 站内 AI Chat 请求等待 agent 返回的超时时间，单位毫秒。
# AI_CHAT_REQUEST_TIMEOUT=1800000
# 全站 agent 并发槽位上限；会员等待队列会优先唤醒。
# AGENT_CONCURRENCY_LIMIT=10

# --- 阿里云短信（注册 / 老邮箱迁移 / 找回密码）------------------------------
# 阿里云短信 AccessKey ID；支持这里的点号键名，也兼容 ALIYUN_SMS_ACCESS_KEY_ID。
# aliyun.sms.access-key-id=your-access-key-id
# 阿里云短信 AccessKey Secret；支持这里的点号键名，也兼容 ALIYUN_SMS_ACCESS_KEY_SECRET。
# aliyun.sms.access-key-secret=your-access-key-secret
# 阿里云短信服务端点；通常保持默认即可。
# aliyun.sms.endpoint=dypnsapi.aliyuncs.com

# --- 计费、提现与维护（可选）------------------------------------------------
# 预留计费请求超过该时长仍未结算时会释放占用，单位毫秒。
# BILLING_RESERVATION_STALE_MS=2400000
# 创作者订阅收入的平台抽成百分比，范围 0-100。
# PLATFORM_CUT_PERCENT=30
# conversation_log_payloads.trace_events 调试数据保留天数；业务消息不受影响。
# TRACE_RETENTION_DAYS=7
# 提现身份证号、银行卡等敏感字段加密密钥；生产环境必填，建议使用 openssl rand -hex 32。
# WITHDRAWAL_ENCRYPTION_KEY=64-char-hex-key-for-withdrawal-sensitive-fields

# --- 日志（可选）------------------------------------------------------------
# 日志等级，例如 trace/debug/info/warn/error。
# LOG_LEVEL=info
# 是否启用 pino-pretty；1 强制开启，0 强制关闭，未配置时非 production 默认开启。
# LOG_PRETTY=1
