{
  "name": "@fateclaw/agent-runtime",
  "version": "1.0.0",
  "type": "module",
  "description": "Account-scoped Agent Runtime for FateClaw (OpenAI-compatible)",
  "license": "GPL-3.0-only",
  "main": "dist/daemon.js",
  "scripts": {
    "build": "node ../../scripts/clean-build-dist.mjs agent-runtime && pnpm --dir ../.. exec tsc -p apps/agent-runtime/tsconfig.build.json && node ../../scripts/copy-shared-assets.mjs agent-runtime",
    "start": "node dist/daemon.js"
  },
  "dependencies": {
    "@fateclaw/contracts": "workspace:*",
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "tyme4ts": "^1.4.5",
    "typebox": "^1.3.23"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
