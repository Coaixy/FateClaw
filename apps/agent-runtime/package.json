{
  "name": "@fateclaw/agent-runtime",
  "version": "1.0.0",
  "type": "module",
  "description": "Account-scoped Agent Runtime for FateClaw (OpenAI-compatible)",
  "license": "GPL-3.0-only",
  "main": "dist/daemon.js",
  "imports": {
    "#agent/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-build-dist.mjs agent-runtime && tsc -p tsconfig.build.json && node ../../scripts/copy-shared-assets.mjs agent-runtime",
    "start": "node dist/daemon.js"
  },
  "dependencies": {
    "@fateclaw/contracts": "workspace:*",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "ioredis": "^6.1.0",
    "pg": "^8.23.1",
    "tyme4ts": "^1.5.6",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.15 <25"
  }
}
