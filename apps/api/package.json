{
  "name": "@fateclaw/api",
  "version": "1.2.21",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/app/index.js",
  "imports": {
    "#app/*": {
      "development": "./src/app/*.ts",
      "default": "./dist/app/*.js"
    },
    "#contracts-adapter/*": {
      "development": "./src/contracts-adapter/*.ts",
      "default": "./dist/contracts-adapter/*.js"
    },
    "#infrastructure/*": {
      "development": "./src/infrastructure/*.ts",
      "default": "./dist/infrastructure/*.js"
    },
    "#interfaces/*": {
      "development": "./src/interfaces/*.ts",
      "default": "./dist/interfaces/*.js"
    },
    "#modules/*": {
      "development": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#runtime/*": {
      "development": "./src/runtime/*.ts",
      "default": "./dist/runtime/*.js"
    },
    "#shared/*": {
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-shared-assets.mjs api",
    "start": "node dist/app/index.js",
    "dev": "pnpm --dir ../.. exec tsx watch --conditions=development apps/api/src/app/index.ts",
    "dev:api-only": "pnpm --dir ../.. exec tsx watch --conditions=development apps/api/src/app/dev-api.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "pnpm --dir ../.. exec prettier --write \"apps/api/src/**/*.ts\" \"apps/api/tests/**/*.ts\"",
    "format:fix": "pnpm --dir ../.. exec prettier --write \"apps/api/src/**/*.ts\" \"apps/api/tests/**/*.ts\"",
    "format:check": "pnpm --dir ../.. exec prettier --check \"apps/api/src/**/*.ts\" \"apps/api/tests/**/*.ts\"",
    "lint": "pnpm --dir ../.. exec eslint apps/api/src/ apps/api/tests/",
    "lint:fix": "pnpm --dir ../.. exec eslint apps/api/src/ apps/api/tests/ --fix",
    "test": "pnpm --dir ../.. exec vitest run --passWithNoTests apps/api/tests",
    "test:watch": "pnpm --dir ../.. exec vitest --passWithNoTests apps/api/tests",
    "login": "pnpm --dir ../.. exec tsx --conditions=development apps/api/src/app/cli.ts login",
    "accounts": "pnpm --dir ../.. exec tsx --conditions=development apps/api/src/app/cli.ts list",
    "account:remove": "pnpm --dir ../.. exec tsx --conditions=development apps/api/src/app/cli.ts remove"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.7",
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-typescript": "^1.8.0",
    "@alicloud/tea-util": "^1.4.11",
    "@earendil-works/pi-ai": "1.6.0",
    "@fastify/compress": "9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.9",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "11.3.7",
    "@fateclaw/contracts": "workspace:*",
    "@types/qrcode-terminal": "^0.12.2",
    "ajv": "8.20.0",
    "bazi-ts-lib": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "iching-shifa": "^1.8.0",
    "ioredis": "^6.1.0",
    "iztro": "^2.6.5",
    "jsdom": "31.0.1",
    "kinqimen": "^0.4.0",
    "liuren-ts-lib": "^3.1.0",
    "meihua-ts-lib": "^0.1.0",
    "mermaid": "12.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tyme4ts": "^1.5.6",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.15 <25"
  }
}
