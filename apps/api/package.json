{
  "name": "@fateclaw/api",
  "version": "1.2.21",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/app/index.js",
  "scripts": {
    "build": "pnpm --dir ../.. exec tsc -p apps/api/tsconfig.json && node ../../scripts/copy-shared-assets.mjs api",
    "start": "node dist/app/index.js",
    "dev": "pnpm --dir ../.. exec tsx watch apps/api/src/app/index.ts",
    "dev:api-only": "pnpm --dir ../.. exec tsx watch apps/api/src/app/dev-api.ts",
    "typecheck": "pnpm --dir ../.. exec tsc --noEmit -p apps/api/tsconfig.json",
    "format": "pnpm --dir ../.. exec prettier --write \"apps/api/src/**/*.ts\" \"apps/api/tests/**/*.ts\"",
    "format:fix": "pnpm --dir ../.. exec prettier --write \"apps/api/src/**/*.ts\" \"apps/api/tests/**/*.ts\"",
    "format:check": "pnpm --dir ../.. exec prettier --check \"apps/api/src/**/*.ts\" \"apps/api/tests/**/*.ts\"",
    "lint": "pnpm --dir ../.. exec eslint apps/api/src/ apps/api/tests/",
    "lint:fix": "pnpm --dir ../.. exec eslint apps/api/src/ apps/api/tests/ --fix",
    "test": "pnpm --dir ../.. exec vitest run --passWithNoTests apps/api/tests",
    "test:watch": "pnpm --dir ../.. exec vitest --passWithNoTests apps/api/tests",
    "login": "pnpm --dir ../.. exec tsx apps/api/src/app/cli.ts login",
    "accounts": "pnpm --dir ../.. exec tsx apps/api/src/app/cli.ts list",
    "account:remove": "pnpm --dir ../.. exec tsx apps/api/src/app/cli.ts remove"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.4",
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-typescript": "^1.8.0",
    "@alicloud/tea-util": "^1.4.11",
    "@fastify/compress": "8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "@fastify/websocket": "11.2.0",
    "@fateclaw/contracts": "workspace:*",
    "@types/qrcode-terminal": "^0.12.2",
    "bazi-ts-lib": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.8.5",
    "iching-shifa": "^1.8.0",
    "ioredis": "^5.10.1",
    "iztro": "^2.5.8",
    "kinqimen": "^0.3.1",
    "liuren-ts-lib": "^3.0.0",
    "meihua-ts-lib": "^0.1.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tyme4ts": "^1.4.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
